{
  "_comment": "Source of truth for DeploymentSim telemetry channel definitions and color-coding thresholds. Used to generate F' GDS dictionary entries and to inform custom dashboard pages. Update thresholds here, then re-run generate_channels.py to refresh the dictionary.",
  "_note": "Thresholds are currently TIGHTENED for testing — they will trigger color changes during normal sim operation. Loosen them once visual confirmation is done.",
  "_threshold_semantics": {
    "low_red": "Critical low — value way below safe operating range",
    "low_orange": "Warning low — value approaching critical",
    "low_yellow": "Caution low — value below nominal but recoverable",
    "high_yellow": "Caution high — value above nominal but recoverable",
    "high_orange": "Warning high — value approaching critical",
    "high_red": "Critical high — value way above safe operating range",
    "default_color": "Anything not crossing a threshold renders as normal/green"
